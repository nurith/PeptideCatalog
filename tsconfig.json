{
  "compilerOptions": {
    "jsx": "preserve",
    "allowJs": true,
    "checkJs": false,
    "moduleResolution": "bundler",
    "module": "ESNext",
    "target": "ES2022",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["astro/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.astro", "astro.config.mjs", "scripts/**/*.mjs"]
}