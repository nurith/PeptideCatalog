---
import '../styles/global.css';

const { title = 'PeptideCatalog' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="A searchable catalog of peptides and protein sequences." />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <nav class="nav container" aria-label="Main navigation">
        <a class="brand" href={base}>PeptideCatalog</a>
        <div class="nav-links">
          <a href={base}>Home</a>
          <a href={`${base}database/`}>Database</a>
          <a href="https://github.com/nurith/PeptideCatalog/blob/master/file.csv">
            Source CSV
          </a>
        </div>
      </nav>
    </header>

    <main class="container page">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        PeptideCatalog · Data and sequences are provided for reference.
      </div>
    </footer>
  </body>
</html>
